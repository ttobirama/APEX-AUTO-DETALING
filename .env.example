# ----------------------------------------------------------------------------
# APEX AUTO DETAILING — server-side environment variables (api/book.js)
# Copy this file to `.env` locally or set these in Vercel/Netlify's UI.
# NEVER commit the real `.env` file (see .gitignore).
# ----------------------------------------------------------------------------

# Resend API key — enables email forwarding of bookings (https://resend.com)
RESEND_API_KEY=

# Inbox that should receive booking notifications
BOOKING_TO_EMAIL=

# Optional: comma-separated origins allowed to call /api/book from another
# domain. Leave empty for same-origin-only (the secure default when the site
# and the function are deployed together on Vercel).
# Example: https://apexauto.example,https://www.apexauto.example
ALLOWED_ORIGIN=
